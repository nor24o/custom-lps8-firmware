#!/bin/sh
echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo ""

# Bring up wlan0 for scanning if it exists but is down
ip link set wlan0 up 2>/dev/null || ifconfig wlan0 up 2>/dev/null
sleep 2

out=$(iwinfo wlan0 scan 2>/dev/null)

if [ -z "$out" ]; then
    echo '{"error":"scan failed - check that kmod-ath9k is loaded"}'
    exit 0
fi

# Parse iwinfo scan output into JSON array
# Each cell block contains ESSID, Signal, Encryption lines
printf '%s\n' "$out" | awk '
BEGIN { printf "["; first=1; pending=0; ssid=""; sig=0; enc="psk2" }

/ESSID:/ {
    # flush previous pending entry
    if (pending) {
        if (!first) printf ","
        printf "{\"ssid\":\"%s\",\"signal\":%d,\"enc\":\"%s\"}", ssid, sig, enc
        first=0
    }
    # start new entry
    n = split($0, a, "\"")
    ssid = (n >= 3) ? a[2] : ""
    gsub(/\\/, "\\\\", ssid)
    gsub(/"/, "\\\"", ssid)
    sig=0; enc="psk2"
    pending = (ssid != "" && ssid != " ") ? 1 : 0
}

/Signal:/ && pending {
    match($0, /-[0-9]+/)
    if (RLENGTH > 0) sig = substr($0, RSTART, RLENGTH) + 0
}

/Encryption:/ && pending {
    if ($0 ~ /[Nn]one/ || $0 ~ /unknown/) enc="none"
    else if ($0 ~ /WPA2/)                 enc="psk2"
    else if ($0 ~ /WPA/)                  enc="psk"
    else                                  enc="psk2"
}

END {
    if (pending) {
        if (!first) printf ","
        printf "{\"ssid\":\"%s\",\"signal\":%d,\"enc\":\"%s\"}", ssid, sig, enc
    }
    print "]"
}
'
