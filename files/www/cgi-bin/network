#!/bin/sh
echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo ""

jstr()  { printf '%s' "$1" | grep -o "\"$2\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | sed 's/.*":[[:space:]]*"//' | tr -d '"'; }
jbool() { printf '%s' "$1" | grep -o "\"$2\"[[:space:]]*:[[:space:]]*[a-z]*" | awk '{print $NF}' | tr -d ' :\"'; }

apply_wifi() {
    wifi_enabled="$1" wifi_ssid="$2" wifi_key="$3" wifi_enc="$4"
    old_ssid=$(uci get wireless.lgsta.ssid 2>/dev/null || echo "")
    if [ "$wifi_enabled" = "true" ] && [ -n "$wifi_ssid" ]; then
        uci set network.wwan=interface
        uci set network.wwan.proto=dhcp
        uci set network.wwan.ifname=wlan0
        uci set network.wwan.metric=20
        uci commit network
        uci set wireless.lgsta=wifi-iface
        uci set wireless.lgsta.device=radio0
        uci set wireless.lgsta.mode=sta
        uci set wireless.lgsta.network=wwan
        uci set wireless.lgsta.ssid="$wifi_ssid"
        case "$wifi_enc" in
            none|"")
                uci set wireless.lgsta.encryption=none
                uci delete wireless.lgsta.key 2>/dev/null ;;
            *)
                uci set wireless.lgsta.encryption="${wifi_enc:-psk2}"
                [ -n "$wifi_key" ] && uci set wireless.lgsta.key="$wifi_key" ;;
        esac
        uci set wireless.radio0.disabled=0
        uci commit wireless
        /etc/init.d/network restart >/dev/null 2>&1 &
    else
        uci delete wireless.lgsta 2>/dev/null
        uci delete network.wwan   2>/dev/null
        uci set wireless.radio0.disabled=1
        uci commit wireless
        uci commit network
        [ -n "$old_ssid" ] && /etc/init.d/network restart >/dev/null 2>&1 &
    fi
}

if [ "$REQUEST_METHOD" = "POST" ]; then
    CL=${CONTENT_LENGTH:-0}
    body=$(head -c "$CL")

    action=$(jstr "$body" action)

    # -- WiFi-only action (Connect button) --
    if [ "$action" = "wifi" ]; then
        apply_wifi \
            "$(jbool "$body" wifi_enabled)" \
            "$(jstr  "$body" wifi_ssid)" \
            "$(jstr  "$body" wifi_key)" \
            "$(jstr  "$body" wifi_enc)"
        echo '{"status":"applied"}'
        exit 0
    fi

    hostname=$(jstr  "$body" hostname)
    lan_proto=$(jstr "$body" lan_proto)
    lan_ip=$(jstr    "$body" lan_ip)
    lan_mask=$(jstr  "$body" lan_mask)
    lan_gw=$(jstr    "$body" lan_gw)
    lan_dns=$(jstr   "$body" lan_dns)
    wifi_enabled=$(jbool "$body" wifi_enabled)
    wifi_ssid=$(jstr     "$body" wifi_ssid)
    wifi_key=$(jstr      "$body" wifi_key)
    wifi_enc=$(jstr      "$body" wifi_enc)

    need_restart=0

    # -- Hostname: apply immediately, no network restart --
    if [ -n "$hostname" ]; then
        old_hn=$(uci get system.@system[0].hostname 2>/dev/null || echo "")
        uci set system.@system[0].hostname="$hostname"
        uci commit system
        echo "$hostname" > /etc/hostname
        echo "$hostname" > /proc/sys/kernel/hostname
        [ "$old_hn" != "$hostname" ] && /etc/init.d/avahi-daemon restart >/dev/null 2>&1 &
    fi

    # -- LAN: restart only when proto or IP actually changes --
    old_proto=$(uci get network.lan.proto  2>/dev/null || echo dhcp)
    old_ip=$(uci get network.lan.ipaddr    2>/dev/null || echo "")

    if [ "$lan_proto" = "static" ] && [ -n "$lan_ip" ]; then
        uci set network.lan.proto=static
        uci set network.lan.ipaddr="$lan_ip"
        uci set network.lan.netmask="${lan_mask:-255.255.255.0}"
        [ -n "$lan_gw"  ] && uci set network.lan.gateway="$lan_gw"
        [ -n "$lan_dns" ] && uci set network.lan.dns="$lan_dns"
        if [ "$old_proto" != "static" ] || [ "$old_ip" != "$lan_ip" ]; then
            need_restart=1
        fi
    else
        uci set network.lan.proto=dhcp
        uci delete network.lan.ipaddr  2>/dev/null
        uci delete network.lan.netmask 2>/dev/null
        uci delete network.lan.gateway 2>/dev/null
        uci delete network.lan.dns     2>/dev/null
        [ "$old_proto" != "dhcp" ] && need_restart=1
    fi
    uci commit network

    # -- WiFi --
    old_ssid=$(uci get wireless.lgsta.ssid 2>/dev/null || echo "")
    if [ "$wifi_enabled" = "true" ] && [ -n "$wifi_ssid" ]; then
        uci set network.wwan=interface
        uci set network.wwan.proto=dhcp
        uci set network.wwan.ifname=wlan0
        uci set network.wwan.metric=20
        uci commit network
        uci set wireless.lgsta=wifi-iface
        uci set wireless.lgsta.device=radio0
        uci set wireless.lgsta.mode=sta
        uci set wireless.lgsta.network=wwan
        uci set wireless.lgsta.ssid="$wifi_ssid"
        case "$wifi_enc" in
            none|"")
                uci set wireless.lgsta.encryption=none
                uci delete wireless.lgsta.key 2>/dev/null ;;
            *)
                uci set wireless.lgsta.encryption="${wifi_enc:-psk2}"
                [ -n "$wifi_key" ] && uci set wireless.lgsta.key="$wifi_key" ;;
        esac
        uci set wireless.radio0.disabled=0
        uci commit wireless
        need_restart=1
    else
        uci delete wireless.lgsta 2>/dev/null
        uci delete network.wwan   2>/dev/null
        uci set wireless.radio0.disabled=1
        uci commit wireless
        uci commit network
        [ -n "$old_ssid" ] && need_restart=1
    fi

    [ "$need_restart" = "1" ] && /etc/init.d/network restart >/dev/null 2>&1 &

    echo '{"status":"applied"}'

else
    # GET — return current settings
    hn=$(uci get system.@system[0].hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || echo dragino)
    lan_proto=$(uci get network.lan.proto   2>/dev/null || echo dhcp)
    lan_ip=$(uci get network.lan.ipaddr     2>/dev/null || echo "")
    lan_mask=$(uci get network.lan.netmask  2>/dev/null || echo "255.255.255.0")
    lan_gw=$(uci get network.lan.gateway    2>/dev/null || echo "")
    lan_dns=$(uci get network.lan.dns       2>/dev/null || echo "")

    wifi_ssid=$(uci get wireless.lgsta.ssid      2>/dev/null || echo "")
    wifi_enc=$(uci get wireless.lgsta.encryption 2>/dev/null || echo "psk2")
    wifi_enabled=false
    [ -n "$wifi_ssid" ] && wifi_enabled=true

    esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

    printf '{"hostname":"%s","lan_proto":"%s","lan_ip":"%s","lan_mask":"%s","lan_gw":"%s","lan_dns":"%s","wifi_enabled":%s,"wifi_ssid":"%s","wifi_enc":"%s"}\n' \
        "$(esc "$hn")" "$lan_proto" "$(esc "$lan_ip")" "$(esc "$lan_mask")" "$(esc "$lan_gw")" "$(esc "$lan_dns")" \
        "$wifi_enabled" "$(esc "$wifi_ssid")" "$wifi_enc"
fi
