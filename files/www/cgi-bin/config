#!/bin/sh
echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo ""

CONF=/etc/lora/config.json

if [ "$REQUEST_METHOD" = "POST" ]; then
    CL=${CONTENT_LENGTH:-0}
    body=$(head -c "$CL")
    case "$body" in
        '{'*) ;;
        *) printf '{"error":"invalid JSON"}\n'; exit 0 ;;
    esac
    mkdir -p /etc/lora
    printf '%s\n' "$body" > "$CONF"
    /etc/init.d/raw_lora_app restart >/dev/null 2>&1 &
    printf '{"status":"saved"}\n'
    exit 0
fi

# GET: serve the config file directly
if [ -f "$CONF" ]; then
    cat "$CONF"
else
    printf '{"error":"config not found"}\n'
fi
