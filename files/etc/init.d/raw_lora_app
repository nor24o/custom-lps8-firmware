#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/raw_lora_app
CONF=/etc/lora/config.json

start_service() {
    [ -x  ] || return 1
    [ -f  ] || return 1

    mkdir -p /var/iot
    echo starting > /var/iot/status

    if [ -x /usr/bin/reset_lgw.sh ]; then
        /usr/bin/reset_lgw.sh start >/dev/null 2>&1
    fi

    procd_open_instance
    procd_set_param command 
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file 
    procd_close_instance

    echo online > /var/iot/status
}

stop_service() {
    echo offline > /var/iot/status
    if [ -x /usr/bin/reset_lgw.sh ]; then
        /usr/bin/reset_lgw.sh stop >/dev/null 2>&1
    fi
}

service_triggers() {
    procd_add_reload_trigger 
}
