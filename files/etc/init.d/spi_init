#!/bin/sh /etc/rc.common

START=20
STOP=90

start() {
    rmmod spi-gpio-custom 2>/dev/null
    # Dragino HE Module SPI Pinout:
    # SCK=GPIO24 (Pin 3), MOSI=GPIO18 (Pin 18), MISO=GPIO20 (Pin 20)
    # CS0=GPIO19 (Pin 19) -> /dev/spidev1.0 (Radio 1 / SX1302)
    # CS1=GPIO15 (Pin 38) -> /dev/spidev1.1 (Radio 2 on dual-channel boards)
    insmod spi-gpio-custom bus0=1,24,18,20,0,8000000,19,0,8000000,15 2>/dev/null || true
}

stop() {
    rmmod spi-gpio-custom 2>/dev/null || true
}
