#!/bin/sh
echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo ""

CONF=/etc/lora/config.json

if [ "$REQUEST_METHOD" = "POST" ]; then
    CL=${CONTENT_LENGTH:-0}
    body=$(head -c "$CL")
    case "$body" in
        '{'*) ;;
        *) printf '{"error":"invalid JSON"}\n'; exit 0 ;;
    esac
    mkdir -p /etc/lora
    printf '%s\n' "$body" > "$CONF"
    /etc/init.d/lg02_pkt_fwd restart >/dev/null 2>&1 &
    printf '{"status":"saved"}\n'
    exit 0
fi

# GET: serve the config file directly (it is already JSON)
if [ -f "$CONF" ]; then
    cat "$CONF"
else
    printf '{"GWID":"a84041ffff16c21c","LAT":"0","LON":"0","DEB":"0","server_type":"lorawan","mode":"0","TXPOWER":"16","email":"user@example.com","DESC":"LG02 Gateway","server_address":"eu1.cloud.thethings.network","upp":"1700","dpp":"1700","RXFREQ":"868100000","RXSF":"7","RXCR":"5","RXBW":"125000","RXPRLEN":"8","RXSYNC":"52","TXFREQ":"868100000","TXSF":"9","TXCR":"5","TXBW":"125000","TXPRLEN":"8","TXSYNC":"52"}\n'
fi
