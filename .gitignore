# Temporary build directories
/bin/
/dl/
/tmp/
.config.old

# Firmware binary dumps and archives in root
/*.bin
/*.tar.gz
/*.tar.xz
firmwarebackup_lps8/
firmwareorg/
sx1302_hal/firmwarebackup_lps8/
sx1302_hal/firmwareorg/

# Compiled objects and intermediate files
*.o
*.a
*.so
tags
.claude/

# Keep essential ImageBuilder metadata
!.config
!.packageinfo
!.profiles.mk
!.targetinfo
!Makefile
!rules.mk
!repositories.conf
scripts/env.sh

# Keep ImageBuilder packages and host tools
!packages/
!packages/**
!staging_dir/
!staging_dir/host/
!staging_dir/host/**
!staging_dir/target-mips_24kc_musl/
!staging_dir/target-mips_24kc_musl/**

# Exclude unnecessary bloated build tools from host
staging_dir/host/bin/*cmake*
staging_dir/host/bin/*ctest*
staging_dir/host/bin/*cpack*
staging_dir/host/bin/*ccache*
staging_dir/host/share/cmake*

# Ignore build_dir except essential Dragino kernels
build_dir/*
!build_dir/target-mips_24kc_musl/
build_dir/target-mips_24kc_musl/*
!build_dir/target-mips_24kc_musl/linux-ar71xx_generic/
build_dir/target-mips_24kc_musl/linux-ar71xx_generic/*
!build_dir/target-mips_24kc_musl/linux-ar71xx_generic/dragino2-kernel.bin
!build_dir/target-mips_24kc_musl/linux-ar71xx_generic/vmlinux
!build_dir/target-mips_24kc_musl/linux-ar71xx_generic/vmlinux.bin.lzma
!build_dir/target-mips_24kc_musl/linux-ar71xx_generic/vmlinux.elf
!build_dir/target-mips_24kc_musl/linux-ar71xx_generic/loader*
