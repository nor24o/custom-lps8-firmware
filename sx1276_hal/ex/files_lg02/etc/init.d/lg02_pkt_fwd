#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/lg02_pkt_fwd
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/lora/config.json
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger /etc/lora/config.json
}
