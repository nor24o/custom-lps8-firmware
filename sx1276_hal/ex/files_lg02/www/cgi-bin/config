#!/bin/sh
echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo ""

CONF=/etc/lora/config.json

if [ "$REQUEST_METHOD" = "POST" ]; then
    CL=${CONTENT_LENGTH:-0}
    body=$(head -c "$CL")
    case "$body" in
        '{'*) ;;
        *) printf '{"error":"invalid JSON"}\n'; exit 0 ;;
    esac
    mkdir -p /etc/lora
    printf '%s\n' "$body" > "$CONF"
    /etc/init.d/lg02_pkt_fwd restart >/dev/null 2>&1 &
    printf '{"status":"saved"}\n'
    exit 0
fi

if [ -f "$CONF" ]; then
    cat "$CONF"
else
    printf '{"target_ip":"192.168.1.8","port_up":5555,"port_down":5556,"status_port":5557,"heartbeat_interval_s":10,"gateway_id":"a84041ffff16c21c","rx_freq":902320000,"rx_sf":7,"rx_bw":125,"rx_cr":5,"rx_prlen":8,"rx_syncword":52,"tx_freq":923300000,"tx_sf":9,"tx_bw":125,"tx_cr":5,"tx_prlen":8,"tx_syncword":52,"tx_power":16,"tx_invert":false,"led_rx":"","led_tx":""}\n'
fi
