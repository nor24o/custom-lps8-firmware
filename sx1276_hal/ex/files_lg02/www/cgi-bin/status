#!/bin/sh
echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo ""

CONF=/etc/lora/config.json

# Read status_port from config (default 5557)
STATUS_PORT=$(grep -o '"status_port"[[:space:]]*:[[:space:]]*[0-9]*' "$CONF" 2>/dev/null | grep -o '[0-9]*$')
[ -z "$STATUS_PORT" ] && STATUS_PORT=5557

# POST: service control action
if [ "$REQUEST_METHOD" = "POST" ]; then
    CL=${CONTENT_LENGTH:-0}
    body=$(head -c "$CL")
    action=$(printf '%s' "$body" | grep -o '"action"[[:space:]]*:[[:space:]]*"[^"]*"' | grep -o '"[^"]*"$' | tr -d '"')
    case "$action" in
        start)   /etc/init.d/lg02_pkt_fwd start   >/dev/null 2>&1; sleep 3 ;;
        stop)    /etc/init.d/lg02_pkt_fwd stop    >/dev/null 2>&1; sleep 1 ;;
        restart) /etc/init.d/lg02_pkt_fwd restart >/dev/null 2>&1; sleep 3 ;;
        enable)  /etc/init.d/lg02_pkt_fwd enable  >/dev/null 2>&1 ;;
        disable) /etc/init.d/lg02_pkt_fwd disable >/dev/null 2>&1 ;;
        *) printf '{"error":"unknown action"}\n'; exit 0 ;;
    esac
fi

# GET live stats from the forwarder's TCP status server
live=$(nc -w1 127.0.0.1 "$STATUS_PORT" </dev/null 2>/dev/null)

running=false
pidof lg02_pkt_fwd >/dev/null 2>&1 && running=true

enabled=false
ls /etc/rc.d/ 2>/dev/null | grep -q '^S[0-9]*lg02_pkt_fwd' && enabled=true

if [ -n "$live" ]; then
    # live JSON from forwarder: {"eui":"...","uptime_s":N,"rx":N,"tx":N,...}
    # strip closing } and append running/enabled
    trimmed=$(printf '%s' "$live" | sed 's/}[[:space:]]*$//')
    printf '%s,"running":%s,"enabled":%s}\n' "$trimmed" "$running" "$enabled"
else
    printf '{"error":"not_running","running":%s,"enabled":%s}\n' "$running" "$enabled"
fi
