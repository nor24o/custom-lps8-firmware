#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

CONF_SX1302=/etc/lora/config.json
CONF_SX1276=/etc/lora/gateway.json

probe_sx1276() {
    if [ -x /usr/bin/simple_spi_rw ]; then
        /usr/bin/simple_spi_rw "$1" "$2" >/dev/null 2>&1
        return $?
    fi
    return 1
}

detect_hardware() {
    local uci_model
    uci_model=$(uci -q get lora.general.concentrator)
    if [ -n "$uci_model" ]; then
        case "$uci_model" in
            sx1302)      echo "sx1302"; return 0 ;;
            sx1276_lg02) echo "lg02";   return 0 ;;
            sx1276_lg01) echo "lg01";   return 0 ;;
        esac
    fi

    if [ -x /usr/bin/raw_lora_app ]; then
        echo "sx1302"
        return 0
    fi

    local r1=1 r2=1
    probe_sx1276 8 0 && r1=0
    probe_sx1276 23 1 && r2=0

    if [ $r1 -eq 0 ] && [ $r2 -eq 0 ]; then
        echo "lg02"
    elif [ $r2 -eq 0 ]; then
        echo "lg01"
    elif [ -x /usr/bin/sx1276_app ]; then
        echo "sx1276"
    elif [ -x /usr/bin/lg02_pkt_fwd ]; then
        echo "lg02"
    else
        echo "none"
    fi
}

start_service() {
    mkdir -p /var/iot /etc/lora /var/log

    local mode
    mode=$(detect_hardware)
    logger -t raw_lora_app "Starting LoRa gateway (mode: $mode)"

    local PROG=""
    local FILECONF="$CONF_SX1302"

    case "$mode" in
        sx1302)
            PROG=/usr/bin/raw_lora_app
            FILECONF="$CONF_SX1302"
            ;;
        sx1276)
            PROG="/usr/bin/sx1276_app -c $CONF_SX1302"
            FILECONF="$CONF_SX1302"
            ;;
        lg02)
            PROG=/usr/bin/lg02_pkt_fwd
            FILECONF="$CONF_SX1276"
            ;;
        lg01)
            PROG=/usr/bin/lg01_pkt_fwd
            FILECONF="$CONF_SX1276"
            ;;
        *)
            logger -t raw_lora_app "No LoRa binary found"
            return 1
            ;;
    esac

    # Run once capturing initial stdout/stderr to /var/log/lora.log and syslog, and manage via procd
    procd_open_instance
    procd_set_param command /bin/sh -c "exec $PROG >> /var/log/lora.log 2>&1"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    [ -f "$FILECONF" ] && procd_set_param file "$FILECONF"
    procd_close_instance
}

stop_service() {
    logger -t raw_lora_app "Stopping LoRa gateway service"
    killall raw_lora_app sx1276_app lg02_pkt_fwd lg01_pkt_fwd 2>/dev/null || true
}

service_triggers() {
    procd_add_reload_trigger "lora"
    [ -f "$CONF_SX1302" ] && procd_add_reload_trigger "$CONF_SX1302"
}
