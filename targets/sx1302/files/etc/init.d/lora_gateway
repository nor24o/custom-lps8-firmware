#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

CONF_SX1302=/etc/lora/config.json

start_service() {
    mkdir -p /var/iot /etc/lora /var/log /tmp
    rm -f /tmp/lora_manual_stop

    # Ensure SQLite databases are initialized
    [ -x /usr/bin/lora_db_init.sh ] && /usr/bin/lora_db_init.sh

    # Start persistent keepalive supervisor via procd with infinite respawn (retry=0)
    procd_open_instance
    procd_set_param command /usr/bin/lora_keepalive.sh
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    [ -f "$CONF_SX1302" ] && procd_set_param file "$CONF_SX1302"
    procd_close_instance
}

stop_service() {
    logger -t raw_lora_app "Stopping LoRa gateway service"
    touch /tmp/lora_manual_stop
    killall raw_lora_app sx1276_app lg02_pkt_fwd lg01_pkt_fwd 2>/dev/null || true
}

service_triggers() {
    procd_add_reload_trigger "lora"
    [ -f "$CONF_SX1302" ] && procd_add_reload_trigger "$CONF_SX1302"
}
