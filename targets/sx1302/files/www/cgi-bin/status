#!/bin/sh
echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo ""

jstr() { printf '%s' "$1" | grep -o "\"$2\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | sed 's/.*":[[:space:]]*"//' | tr -d '"'; }

# Determine running binary and mode
hw_mode="none"
running=false
if pidof lg02_pkt_fwd >/dev/null 2>&1; then
    running=true; hw_mode="LG02"
elif pidof lg01_pkt_fwd >/dev/null 2>&1; then
    running=true; hw_mode="LG01"
elif pidof raw_lora_app >/dev/null 2>&1; then
    running=true; hw_mode="SX1302"
fi

enabled=false
ls /etc/rc.d/ 2>/dev/null | grep -q '^S[0-9]*lg02_pkt_fwd' && enabled=true

if [ "$REQUEST_METHOD" = "POST" ]; then
    CL=${CONTENT_LENGTH:-0}
    body=$(head -c "$CL")
    action=$(jstr "$body" action)
    case "$action" in
        start)   /etc/init.d/lg02_pkt_fwd start   >/dev/null 2>&1; sleep 3 ;;
        stop)    /etc/init.d/lg02_pkt_fwd stop    >/dev/null 2>&1; sleep 1 ;;
        restart) /etc/init.d/lg02_pkt_fwd restart >/dev/null 2>&1; sleep 3 ;;
        enable)  /etc/init.d/lg02_pkt_fwd enable  >/dev/null 2>&1 ;;
        disable) /etc/init.d/lg02_pkt_fwd disable >/dev/null 2>&1 ;;
        *) printf '{"error":"unknown action"}\n'; exit 0 ;;
    esac
    # Re-check state
    running=false; hw_mode="none"
    if pidof lg02_pkt_fwd >/dev/null 2>&1; then
        running=true; hw_mode="LG02"
    elif pidof lg01_pkt_fwd >/dev/null 2>&1; then
        running=true; hw_mode="LG01"
    elif pidof raw_lora_app >/dev/null 2>&1; then
        running=true; hw_mode="SX1302"
    fi
    enabled=false
    ls /etc/rc.d/ 2>/dev/null | grep -q '^S[0-9]*lg02_pkt_fwd' && enabled=true
    printf '{"status":"ok","running":%s,"enabled":%s,"hw_mode":"%s"}\n' \
        "$running" "$enabled" "$hw_mode"
    exit 0
fi

conn=$(cat /var/iot/status 2>/dev/null | tr -d '[:space:]')
[ "$conn" = "online" ] && online=true || online=false

printf '{"running":%s,"online":%s,"enabled":%s,"hw_mode":"%s"}\n' \
    "$running" "$online" "$enabled" "$hw_mode"
