#!/bin/sh /etc/rc.common

START=20
STOP=90

start() {
    rmmod spi-gpio-custom 2>/dev/null
    # Dragino LG01 / LG02 Dual SPI Bus Configuration:
    # Radio 1 (Bus 1 -> /dev/spidev1.0): SCK=GPIO14, MOSI=GPIO16, MISO=GPIO26, CS0=GPIO15
    # Radio 2 (Bus 2 -> /dev/spidev2.0): SCK=GPIO18, MOSI=GPIO21, MISO=GPIO19, CS0=GPIO24
    insmod spi-gpio-custom bus0=1,14,16,26,0,8000000,15 bus1=2,18,21,19,0,8000000,24 2>/dev/null || true
}

stop() {
    rmmod spi-gpio-custom 2>/dev/null || true
}
