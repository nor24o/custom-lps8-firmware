#!/bin/sh
echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo ""

if [ "$REQUEST_METHOD" = "POST" ]; then
    CL=${CONTENT_LENGTH:-0}
    body=$(head -c "$CL")
    first=$(printf '%s' "$body" | cut -c1)
    if [ "$first" = "{" ]; then
        mkdir -p /etc/lora
        printf '%s' "$body" > /etc/lora/config.json \
            && /etc/init.d/sx1276_app restart >/dev/null 2>&1 \
            && echo '{"status":"saved"}' \
            || echo '{"error":"write failed"}'
    else
        echo '{"error":"invalid JSON"}'
    fi
else
    cat /etc/lora/config.json 2>/dev/null || echo '{"error":"config not found"}'
fi
