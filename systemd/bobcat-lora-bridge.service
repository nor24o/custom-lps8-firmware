[Unit]
Description=Bobcat LoRa Packet Ingestion, Multi-Scheme Decoder & HA MQTT Bridge
After=network.target raw-lora.service
Wants=raw-lora.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 -u /usr/local/bin/bobcat_lora_bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
