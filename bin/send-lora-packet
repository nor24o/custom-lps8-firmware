#!/usr/bin/env python3
import socket
import json
import base64
import sys

# Default test packet: magic bytes 0x6B 0x5A, target 0x01, sender 0xFE, cmd
payload = b'\x6B\x5A\x01\xFE\x02\x01\x01\x01'
b64 = base64.b64encode(payload).decode('ascii')

pkt = {
    "imme": True,
    "freq": 868.1,
    "rfch": 0,
    "powe": 14,
    "modu": "LORA",
    "datr": "SF7BW125",
    "codr": "4/5",
    "ipol": False,
    "data": b64
}

s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.sendto(json.dumps(pkt).encode('utf-8'), ('127.0.0.1', 5556))
s.close()
print("Sent test downlink packet to 127.0.0.1:5556")
